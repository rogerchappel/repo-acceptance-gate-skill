{
  "name": "repo-acceptance-gate-skill",
  "version": "0.1.0",
  "description": "Deterministic release-candidate acceptance packets for agent-built repos.",
  "type": "module",
  "bin": {
    "repo-acceptance-gate": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/*.js test/*.test.js",
    "build": "node --check src/*.js test/*.test.js",
    "smoke": "node src/cli.js check fixtures/node-package --format markdown",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agent-skill",
    "release-candidate",
    "acceptance",
    "repo-audit"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "fixtures",
    "docs",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/repo-acceptance-gate-skill.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/repo-acceptance-gate-skill/issues"
  },
  "homepage": "https://github.com/rogerchappel/repo-acceptance-gate-skill#readme"
}
